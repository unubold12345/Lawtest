generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Auth.js models (Prisma adapter)
// https://authjs.dev/getting-started/migrating-to-v5#prisma-adapter
enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?   @unique
  phoneVerified DateTime?
  role          Role      @default(USER)
  paidAt        DateTime?
  passwordChangedAt DateTime?
  accounts      Account[]
  sessions      Session[]
  attempts      Attempt[]
  comments      Comment[]
  reports       Report[]
  notes         QuestionNote[]
  mistakes      Mistake[]
  savedAnswers  SavedAnswer[]
  savedExams    SavedExam[]
  studyCards    StudyCard[]
  paymentRequests PaymentRequest[]
  otps          Otp[]
  visits        PageView[]
  announcements      Announcement[] @relation("AnnouncementAuthor")
  receivedAnnouncements Announcement[] @relation("AnnouncementRecipients")
  announcementReads  AnnouncementRead[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Attempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  mode        String // exam | study
  score       Int
  total       Int
  elapsed     Int // seconds
  answers     String // JSON stringified Record<string, number>
  questionIds String // JSON stringified string[]
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model Comment {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([questionId, createdAt])
  @@index([userId])
}

model Report {
  id         String   @id @default(cuid())
  questionId String
  type       String // WRONG_ANSWER | WRONG_OPTIONS | QUESTION_ERROR | OTHER
  message    String
  status     String   @default("OPEN") // OPEN | RESOLVED
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([questionId])
}

model QuestionNote {
  id         String   @id @default(cuid())
  questionId String
  content    String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
}

model Mistake {
  id         String   @id @default(cuid())
  questionId String
  wrongCount Int      @default(0)
  manual     Boolean  @default(false)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
}

model SavedAnswer {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answer     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([questionId])
}

// Per-question study progress for the /study page (Сорилго v2).
// One row per user+question once it has been answered in a study session.
model StudyCard {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  attempts   Int      @default(0)
  correct    Int      @default(0)
  streak     Int      @default(0) // consecutive correct answers (resets on wrong)
  lastOk     Boolean  @default(false)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId, lastSeenAt])
  @@index([userId, lastOk])
}

model Otp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  purpose   String   @default("login") // register | recover | login (legacy)
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, expiresAt])
  @@index([phone, createdAt])
  @@index([phone, purpose])
}

model SavedExam {
  id        String   @id @default(cuid())
  userId    String
  key       String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model PaymentRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())
  decidedAt DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

// Anonymous page-view tracking (guests + members; no IP/PII stored)
model PageView {
  id        String   @id @default(cuid())
  path      String
  sessionId String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId, createdAt])
  @@index([path, createdAt])
  @@index([userId, createdAt])
}

model QuestionOverride {
  questionId  String   @id
  question    String?
  options     Json?
  answer      Int?
  explanation String?
  lawRef      String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Site-wide announcements shown in the navbar bell (logged-in users only)
model Announcement {
  id          String   @id @default(cuid())
  body        String
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  recipients  User[]   @relation("AnnouncementRecipients")
  reads       AnnouncementRead[]

  @@index([createdAt])
}

model AnnouncementRead {
  userId         String
  announcementId String
  readAt         DateTime @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([userId, announcementId])
  @@index([announcementId])
}

// Admin "fixed" marks per data file (category folder + subcategory filename),
// shown green in the browse dropdowns for admins only.
model CategoryFix {
  id          String   @id @default(cuid())
  category    String
  subCategory String   @default("")
  fixedAt     DateTime @default(now())

  @@unique([category, subCategory])
}
